# ===========================
# Root .gitignore (videogen)
# ===========================

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
node_modules/
.env
.env.*
!.env.example
dist/
build/
.next/
.turbo/
.venv/
__pycache__/
*.pyc

# Safe security ignores
.env.local
